using UnityEngine;
using UnityEngine.UI;
using System.Collections.Generic;

// ================= ENUMS =================

public enum TileType
{
    Empty,
    Path,
    TJunction,
    Cross,
    RopeSingle,
    RopeDouble,
    ZiplineStart,
    ZiplineEnd
}

// ================= TILE =================

public class Tile : MonoBehaviour
{
    public TileType tileType;
    public bool north, east, south, west;
    public int scoreValue = 1;
    public int capacity = 99;

    public Tile linkedZipline;

    private int currentOccupants = 0;

    void Awake()
    {
        if (tileType == TileType.RopeSingle) capacity = 1;
        if (tileType == TileType.RopeDouble) capacity = 2;
    }

    public bool CanEnter() => currentOccupants < capacity;
    public void Enter() => currentOccupants++;
    public void Exit() => currentOccupants = Mathf.Max(0, currentOccupants - 1);
}

// ================= GAME MANAGER =================

public class GameManager : MonoBehaviour
{
    public int width = 20;
    public int height = 20;
    public GameObject[] tilePrefabs;

    public GameObject agentPrefab;
    public GameObject builderPrefab;

    private GameObject[,] grid;

    private GameObject[] units;
    private int currentUnit = 0;

    private int selectedTileIndex = 1;
    private float rotationY = 0f;

    void Start()
    {
        grid = new GameObject[width, height];
        CreateHomeBase();
        SpawnUnits();
    }

    void Update()
    {
        HandleTouchMovement();
    }

    // ================= GRID =================

    void CreateHomeBase()
    {
        int cx = width / 2;
        int cy = height / 2;

        PlaceTile(cx, cy, 3);
        PlaceTile(cx + 1, cy, 3);
        PlaceTile(cx, cy + 1, 3);
        PlaceTile(cx + 1, cy + 1, 3);
    }

    public void PlaceTile(int x, int y, int index)
    {
        if (!InBounds(x, y)) return;

        if (grid[x, y] != null)
            Destroy(grid[x, y]);

        GameObject tile = Instantiate(tilePrefabs[index], new Vector3(x, 0, y), Quaternion.Euler(0, rotationY, 0));
        grid[x, y] = tile;
    }

    public Tile GetTile(int x, int y)
    {
        if (!InBounds(x, y)) return null;
        if (grid[x, y] == null) return null;
        return grid[x, y].GetComponent<Tile>();
    }

    bool InBounds(int x, int y)
    {
        return x >= 0 && y >= 0 && x < width && y < height;
    }

    // ================= TOUCH CONTROLS =================

    void HandleTouchMovement()
    {
        if (Input.touchCount == 0) return;

        Touch touch = Input.GetTouch(0);

        if (touch.phase == TouchPhase.Began)
        {
            Ray ray = Camera.main.ScreenPointToRay(touch.position);
            RaycastHit hit;

            if (Physics.Raycast(ray, out hit))
            {
                Vector3 point = hit.point;
                Vector2Int target = new Vector2Int(Mathf.FloorToInt(point.x), Mathf.FloorToInt(point.z));

                PlayerUnit unit = units[currentUnit].GetComponent<PlayerUnit>();
                unit.TryMove(target);
            }
        }
    }

    // ================= SPAWN =================

    void SpawnUnits()
    {
        units = new GameObject[4];
        Vector3 spawn = new Vector3(width / 2, 0, height / 2);

        for (int i = 0; i < 3; i++)
        {
            units[i] = Instantiate(agentPrefab, spawn, Quaternion.identity);
            units[i].GetComponent<PlayerUnit>().Init(this, true);
        }

        units[3] = Instantiate(builderPrefab, spawn, Quaternion.identity);
        units[3].GetComponent<PlayerUnit>().Init(this, false);
    }

    // ================= UI BUTTONS =================

    public void SelectUnit(int index)
    {
        currentUnit = index;
    }

    public void SelectTile(int index)
    {
        selectedTileIndex = index;
    }

    public void RotateTile()
    {
        rotationY += 90f;
    }
}

// ================= PLAYER UNIT =================

public class PlayerUnit : MonoBehaviour
{
    private GameManager gm;
    private bool isAgent;

    public Vector2Int gridPos;
    public int score = 0;

    public void Init(GameManager manager, bool agent)
    {
        gm = manager;
        isAgent = agent;
        gridPos = new Vector2Int(Mathf.RoundToInt(transform.position.x), Mathf.RoundToInt(transform.position.z));
    }

    public void TryMove(Vector2Int target)
    {
        if (!isAgent)
        {
            MoveFree(target);
            return;
        }

        Vector2Int dir = target - gridPos;
        if (Mathf.Abs(dir.x) + Mathf.Abs(dir.y) != 1) return;

        Tile current = gm.GetTile(gridPos.x, gridPos.y);
        Tile next = gm.GetTile(target.x, target.y);

        if (current == null || next == null) return;
        if (!IsConnected(dir, current, next)) return;
        if (!next.CanEnter()) return;

        current.Exit();
        next.Enter();

        gridPos = target;
        transform.position = new Vector3(gridPos.x, 0, gridPos.y);

        score += next.scoreValue;

        HandleZipline(next);
    }

    void MoveFree(Vector2Int target)
    {
        gridPos = target;
        transform.position = new Vector3(gridPos.x, 0, gridPos.y);
    }

    bool IsConnected(Vector2Int dir, Tile a, Tile b)
    {
        if (dir == Vector2Int.up) return a.north && b.south;
        if (dir == Vector2Int.right) return a.east && b.west;
        if (dir == Vector2Int.down) return a.south && b.north;
        if (dir == Vector2Int.left) return a.west && b.east;
        return false;
    }

    void HandleZipline(Tile tile)
    {
        if (tile.tileType != TileType.ZiplineStart) return;
        if (tile.linkedZipline == null) return;

        Tile end = tile.linkedZipline;

        gridPos = new Vector2Int(
            Mathf.RoundToInt(end.transform.position.x),
            Mathf.RoundToInt(end.transform.position.z)
        );

        transform.position = end.transform.position;

        score += end.scoreValue;
    }
}

// ================= CAMERA CONTROLLER =================

public class TouchCamera : MonoBehaviour
{
    public float panSpeed = 0.1f;
    public float zoomSpeed = 0.1f;

    void Update()
    {
        if (Input.touchCount == 1)
        {
            Touch touch = Input.GetTouch(0);

            if (touch.phase == TouchPhase.Moved)
            {
                Vector2 delta = touch.deltaPosition;
                transform.Translate(-delta.x * panSpeed, 0, -delta.y * panSpeed);
            }
        }

        if (Input.touchCount == 2)
        {
            Touch t1 = Input.GetTouch(0);
            Touch t2 = Input.GetTouch(1);

            float prevDist = (t1.position - t1.deltaPosition - (t2.position - t2.deltaPosition)).magnitude;
            float currDist = (t1.position - t2.position).magnitude;

            float diff = currDist - prevDist;

            transform.position += transform.forward * diff * zoomSpeed;
        }
    }
}
